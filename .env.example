# Copy this file to .env (never commit .env) and fill in your key.
# Get a free API key from https://aistudio.google.com
GEMINI_API_KEY=your-api-key-here

# Optional. Leave it out to use Google's current Flash-Lite model ("gemini-flash-lite-latest").
# To pin one model, copy its exact id from AI Studio, e.g. a Flash model marked free.
# GEMINI_MODEL=
